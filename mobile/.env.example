# Copy to .env.local (git-ignored) and fill in from the Supabase dashboard.
# EXPO_PUBLIC_* vars are inlined into the client bundle at build time — they
# are not secret. The anon key is meant to be public; RLS is what protects
# data, not keeping this value hidden. No provider API key belongs here —
# those live only as Supabase edge function secrets (see supabase/README.md).

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
